  "nodes": [
    {
      "id": "start",
      "kind": "start",
      "at": {
        "block": "hero",
        "anchor": "top"
      }
    },
    {
      "id": "hero",
      "kind": "block",
      "page": "home",
      "target": [
        {
          "sr": "hero"
        }
      ],
      "hold_ms": 1200
    },
    {
      "id": "stats",
      "kind": "block",
      "page": "home",
      "target": [
        {
          "sr": "stats"
        }
      ],
      "hold_ms": 1600
    },
    {
      "id": "features",
      "kind": "block",
      "page": "home",
      "target": [
        {
          "sr": "features"
        }
      ],
      "hold_ms": 600
    },
    {
      "id": "tabs",
      "kind": "block",
      "page": "home",
      "target": [
        {
          "sr": "tabs"
        }
      ],
      "hold_ms": 1200,
      "actions": [
        {
          "do": "click",

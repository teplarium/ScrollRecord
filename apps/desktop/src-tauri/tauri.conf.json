{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScrollRecord",
  "identifier": "io.github.teplarium.scrollrecord",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScrollRecord",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "category": "Video",
    "shortDescription": "Record smooth website scroll videos",
    "longDescription": "ScrollRecord renders smooth scroll videos of websites on desktop and mobile viewports, with a visual cursor, a FigJam-like scenario editor and AI-friendly scenario files.",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

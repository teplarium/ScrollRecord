{
  "format_version": 1,
  "meta": {
    "name": "Untitled 1",
    "site": "../tests/fixtures/sites/01-plain-landing"
  },
  "targets": [
    {
      "id": "desktop",
      "viewport": "desktop-1920",
      "aspect": "16:9",
      "resolution": "1080p",
      "fps": 60,
      "format": "mp4",
      "fit": "fill-viewport",
      "frame": "viewport"
    },
    {
      "id": "mobile",
      "viewport": "iphone-15",
      "aspect": "9:16",
      "resolution": "1080p",
      "fps": 60,
      "format": "mp4",
      "fit": "fill-viewport",
      "frame": "viewport"
    }
  ],
  "defaults": {
    "scroll": {
      "speed_px_s": 1000.0,
      "easing": "ease-in-out"
    },
    "hold_ms": 1200,
    "cursor": {
      "pack": "classic-dark",
      "scale": 1.0,
      "seed": 7,
      "visible": true,
      "start": {
        "x": 0.68,
        "y": 0.62
      },
      "speed": 1.0
    }
  },
  "prepare": {
    "hide": [],
    "preload_lazy": true,
    "wait": "load"
  },
  "pages": [
    {
      "id": "home",
      "url": "/"
    }
  ],
  "nodes": [
    {
      "kind": "start",
      "id": "start",
      "at": {
        "block": "hero",
        "anchor": "top",
        "offset_px": 0.0
      },
      "warmup_ms": 0
    },
    {
      "kind": "block",
      "id": "hero",
      "page": "home",
      "target": [
        {
          "sr": "hero"
        }
      ],
      "align": "top",
      "offset_px": 0.0,
      "hold_ms": 1500,
      "actions": [
        {
          "do": "hover",
          "target": [
            {
              "text": "Get started"
            }
          ],
          "duration_ms": 900,
          "delay_ms": 0,
          "only": [
            "desktop"
          ]
        }
      ]
    },
    {
      "kind": "block",
      "id": "features",
      "page": "home",
      "target": [
        {
          "sr": "features"
        }
      ],
      "align": "top",
      "offset_px": 0.0,
      "hold_ms": 0
    },
    {
      "kind": "block",
      "id": "steps",
      "page": "home",
      "target": [
        {
          "sr": "steps"
        }
      ],
      "align": "top",
      "offset_px": 0.0,
      "hold_ms": 1200
    },
    {
      "kind": "block",
      "id": "quote",
      "page": "home",
      "target": [
        {
          "sr": "quote"
        }
      ],
      "align": "center",
      "offset_px": 0.0,
      "hold_ms": 0
    },
    {
      "kind": "block",
      "id": "pricing",
      "page": "home",
      "target": [
        {
          "sr": "pricing"
        },
        {
          "css": "#pricing"
        }
      ],
      "align": "center",
      "offset_px": 0.0,
      "hold_ms": 1500,
      "actions": [
        {
          "do": "hover",
          "target": [
            {
              "css": ".plan--pro"
            }
          ],
          "duration_ms": 500,
          "delay_ms": 0,
          "only": [
            "desktop"
          ]
        },
        {
          "do": "click",
          "target": [
            {
              "text": "Choose Pro"
            }
          ],
          "delay_ms": 150
        }
      ]
    },
    {
      "kind": "block",
      "id": "footer",
      "page": "home",
      "target": [
        {
          "sr": "footer"
        }
      ],
      "align": "top",
      "offset_px": 0.0
    },
    {
      "kind": "end",
      "id": "end",
      "at": {
        "block": "footer",
        "anchor": "bottom",
        "offset_px": 0.0
      },
      "hold_ms": 800
    }
  ],
  "edges": [
    {
      "from": "start",
      "to": "hero",
      "scroll": {}
    },
    {
      "from": "hero",
      "to": "features",
      "scroll": {}
    },
    {
      "from": "features",
      "to": "steps",
      "scroll": {}
    },
    {
      "from": "steps",
      "to": "quote",
      "scroll": {}
    },
    {
      "from": "quote",
      "to": "pricing",
      "scroll": {}
    },
    {
      "from": "pricing",
      "to": "end",
      "scroll": {
        "duration_ms": 1200
      },
      "cursor": "hide"
    }
  ],
  "overrides": {
    "iphone-15": {
      "nodes": {
        "pricing": {
          "skip": false,
          "hold_ms": 2000,
          "align": "top"
        }
      }
    }
  }
}
